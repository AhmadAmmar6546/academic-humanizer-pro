# Set these securely in Vercel Project Settings -> Environment Variables.
# Local development only: copy this template to ignored .env.local.
ENABLE_EXPERIMENTAL_COREPACK=1
DATABASE_URL=
APP_PASSWORD=
SESSION_SECRET=
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash
# DATABASE_URL must be a Neon PostgreSQL connection string with TLS enabled.
# APP_PASSWORD: a unique strong password, at least 12 characters.
# SESSION_SECRET: a random secret, at least 32 characters.
# Never commit real values or use NEXT_PUBLIC_ names for these credentials.
